{
  "name": "moonclock",
  "version": "0.118.0",
  "private": true,
  "type": "module",
  "scripts": {
    "app:dev": "next dev",
    "app:test": "APP_ENV=test next dev",
    "app:build": "next build",
    "build": "rm -rf dist moonclock release.tar.gz && next build; node build.js",
    "app": "next start -p 80",
    "lint": "eslint .",
    "hardware:dev": "MOONCLOCK_APP_PORT=3000 tsx watch --clear-screen=false hardware/index.ts --emulate true",
    "hardware": "tsx hardware/index.ts",
    "start:dev": "concurrently \"npm run app:dev\" \"npm run hardware:dev\"",
    "peer:dev": "MOONCLOCK_DATABASE=./database-peer.json MOONCLOCK_DIST_DIR=.next-peer MOONCLOCK_APP_PORT=3010 MOONCLOCK_HARDWARE_PORT=3011 concurrently \"next dev -p 3010\" \"tsx watch --clear-screen=false hardware/index.ts --emulate true\"",
    "test:e2e": "playwright test",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test": "APP_ENV=test tsx --test $(find . -name '*.test.ts' -not -path '*/node_modules/*')",
    "release": "bin/release.sh"
  },
  "dependencies": {
    "@mantine/charts": "^9.8.2",
    "@mantine/core": "^9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@tabler/icons-react": "^3.53.0",
    "bonjour-service": "^1.4.4",
    "express": "^5.3.0",
    "next": "^16.4.6",
    "onoff": "^6.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "rpi-led-matrix": "^1.14.0",
    "semver": "^7.8.6",
    "skia-canvas": "^3.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.34",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "timekeeper": "^2.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0"
  }
}
