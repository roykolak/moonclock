#!/bin/bash
set -euo pipefail

# Runs at boot before the web app. If the Pi already has a network connection,
# it exits immediately and the app starts as usual. If it's offline, it launches
# balena wifi-connect, which broadcasts an open "$PORTAL_SSID" hotspot and serves
# our custom captive portal (wifi-connect-ui/) where the user picks their network
# and enters the password. wifi-connect blocks until the device is connected,
# then exits — at which point systemd lets moonclock-app start.
#
# The moonclock-hardware service runs independently and mirrors this state on the
# LED panel (a "setup needed" animation) via hardware/wifi.

# Broadcast SSID for the setup hotspot the user connects their phone to.
PORTAL_SSID="Moonclock"

# Our own portal page, shipped inside the release so it self-updates with the
# app. `current` symlinks to the active release (see install.sh).
UI_DIR="/usr/local/bin/moonclock/current/wifi-connect-ui"

# Give NetworkManager a moment on a cold boot to bring up a known network before
# we decide the device is offline. Polled once a second rather than a flat
# `sleep 15` up front: moonclock-app pulls this unit in on every restart
# (Wants=/After=, and a oneshot without RemainAfterExit goes inactive again), so
# the blind sleep charged its full 15s to every app restart and every update, not
# just to a cold boot. A clock that is already online now exits on the first
# check, while a genuinely offline one still waits the same 15s before opening
# the portal.
for _ in $(seq 15); do
  if nmcli -t -f STATE general status | grep -q "^connected"; then
    echo "[wifi-provision] Already connected; skipping setup portal."
    exit 0
  fi
  sleep 1
done

if ! command -v wifi-connect >/dev/null 2>&1; then
  echo "[wifi-provision] wifi-connect is not installed; skipping setup portal." >&2
  exit 0
fi

echo "[wifi-provision] Offline — starting setup portal (SSID: $PORTAL_SSID)."
exec wifi-connect \
  --portal-ssid "$PORTAL_SSID" \
  --ui-directory "$UI_DIR"
