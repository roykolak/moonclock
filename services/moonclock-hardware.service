[Unit]
Description=Moonclock Hardware ({VERSION})

[Service]
User=root
Group=root
# skia-canvas's bundled fontconfig can't find a default config on its own
# ("Cannot load default config file"); point it at the system one.
Environment=FONTCONFIG_PATH=/etc/fonts
Type=simple
Restart=always
RestartSec=5
TimeoutStopSec=600
WorkingDirectory=/usr/local/bin/moonclock/current/dist/hardware
ExecStart=sudo NODE_ENV=production node index.cjs

[Install]
WantedBy=default.target