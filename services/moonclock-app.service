[Unit]
Description=Moonclock App ({VERSION})
After=network.target moonclock-wifi-provision.service
Wants=network.target
# Wait for WiFi provisioning to finish (it releases port 80 when it exits or is
# skipped) before starting the web app on port 80.
Wants=moonclock-wifi-provision.service

[Service]
User=root
Group=root
Environment=PORT=80
Environment=NEXT_MANUAL_SIG_HANDLE=1
Type=simple
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=300
TimeoutStopSec=5
WorkingDirectory=/usr/local/bin/moonclock/current/dist/app
ExecStart=/usr/local/bin/node server.js

[Install]
WantedBy=default.target