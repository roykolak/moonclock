#!/bin/bash

# Check if an argument was provided
if [ $# -eq 0 ]; then
    echo "Usage: $0 [start|stop|restart|logs]"
    exit 1
fi

case "$1" in
    logs)
        journalctl -f -u moonclock-app -u moonclock-hardware -u moonclock-wifi-provision -u moonclock-update-checker.timer -n 100
        ;;
    restart)
        echo "Restarting Moonclock app & hardware client"
        # One call so systemd restarts these concurrently. Done in sequence, the
        # panel stayed dark for however long the app took to drain its
        # connections on SIGTERM — measured between 0s and 7s across updates —
        # even though the hardware service has no dependency on the app at all.
        systemctl restart moonclock-app moonclock-hardware moonclock-update-checker.timer
        ;;
    start)
        echo "Starting Moonclock app & hardware client"
        systemctl start moonclock-app
        systemctl start moonclock-hardware
        systemctl start moonclock-update-checker.timer
        ;;
    stop)
        echo "Stopping Moonclock app & hardware client"
        systemctl stop moonclock-app
        systemctl stop moonclock-hardware
        systemctl stop moonclock-update-checker.timer
        ;;
    status)
        echo "Starting Moonclock app & hardware client"
        systemctl status moonclock-app moonclock-hardware moonclock-wifi-provision moonclock-update-checker.timer
        ;;
    *)
        echo "Invalid option."
        exit 1
        ;;
esac